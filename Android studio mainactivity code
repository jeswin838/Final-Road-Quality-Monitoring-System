    /**
     * Replaces the old processLatestClip logic. Acts as the Central Trigger Manager.
     * Starts detection immediately if free, otherwise schedules EXACTLY ONE pending detection.
     */
    void requestDetection() {

        Log.d("REQUEST_DEBUG",
                "requestDetection()" +
                        " | processing=" + isProcessing.get() +
                        " | pending=" + pendingDetection.get() +
                        " | bufferSize=" + frameBuffer.size());

        if (isProcessing.compareAndSet(false, true)) {

            Log.d(TAG, "Starting new detection sequence.");

            executeDetectionSequence();

        } else {

            // Already processing - safely queue ONE smart pending detection
            pendingDetection.set(true);

            Log.d(TAG, "Detection currently running. Request logged as PENDING.");
        }
    }

    private void executeDetectionSequence() {
        analysisExecutor.execute(() -> {
            try {
                List<FrameData> selectedFrames;

                synchronized (frameBuffer) {

                    if (frameBuffer.isEmpty()) {
                        Log.d(TAG, "Frame buffer is empty. Aborting.");
                        finishDetection();
                        return;
                    }

                    Log.d("FRAME_BUFFER", "================================");
                    Log.d("FRAME_BUFFER", "Buffer Size = " + frameBuffer.size());

                    int idx = 0;
                    for (FrameData frame : frameBuffer) {
                        Log.d("FRAME_BUFFER",
                                "Buffer[" + idx + "]" +
                                        " bytes=" + frame.jpegData.length +
                                        " hash=" + java.util.Arrays.hashCode(frame.jpegData) +
                                        " quality=" + frame.qualityScore);
                        idx++;
                    }

                    // Select the BEST 10 frames based on weighted stability ranking
                    // Select only NEW frames that haven't been processed yet
                    selectedFrames = frameBuffer.stream()
                            .filter(f -> f.frameId > lastProcessedFrameId)
                            .sorted((a, b) -> Float.compare(b.qualityScore, a.qualityScore))
                            .limit(10)
                            .collect(Collectors.toList());
                }

                Log.d("FRAME_SELECTION", "========== SELECTED ==========");

                for (int i = 0; i < selectedFrames.size(); i++) {

                    FrameData frame = selectedFrames.get(i);

                    Log.d("FRAME_SELECTION",
                            "Selected[" + i + "]" +
                                    " frameId=" + frame.frameId +
                                    " bytes=" + frame.jpegData.length +
                                    " hash=" + java.util.Arrays.hashCode(frame.jpegData) +
                                    " quality=" + frame.qualityScore);
                }

                Log.d("FRAME_SELECTION", "==============================");
                Log.d(TAG, "Selected " + selectedFrames.size() + " best frames from RAM.");

// Do not upload if there are no new frames
                if (selectedFrames.isEmpty()) {
                    Log.d(TAG, "No new frames available. Skipping upload.");
                    finishDetection();
                    return;
                }

                getLocationAndUpload(selectedFrames);

            } catch (Exception e) {
                Log.e(TAG, "Frame selection failed", e);
                finishDetection();
            }
        });
    }

    private void finishDetection() {
        // Release the primary lock
        isProcessing.set(false);

        // Check if a new trigger fired while we were processing
        if (pendingDetection.compareAndSet(true, false)) {
            Log.d(TAG, "Pending detection found. Starting follow-up detection immediately.");
            requestDetection();
        }
    }

    // =========================================================
    // UPLOAD LOGIC
    // =========================================================

    void getLocationAndUpload(List<FrameData> frames) {
        if (ActivityCompat.checkSelfPermission(this, Manifest.permission.ACCESS_FINE_LOCATION) != PackageManager.PERMISSION_GRANTED) {
            Log.e(TAG, "Location permission missing.");
            finishDetection();
            return;
        }

        fusedLocationClient.getCurrentLocation(Priority.PRIORITY_HIGH_ACCURACY, null)
                .addOnSuccessListener(location -> {
                    if (location != null) {
                        uploadImages(frames, location);
                    } else {
                        Log.w(TAG, "Location is null, dropping upload.");
                        finishDetection();
                    }
                })
                .addOnFailureListener(e -> {
                    Log.e(TAG, "Location request failed", e);
                    finishDetection();
                });
    }

    void uploadImages(List<FrameData> frames, Location location) {

        // Safety check
        if (frames == null || frames.isEmpty()) {
            Log.d("UPLOAD", "No frames to upload. Skipping request.");
            finishDetection();
            return;
        }

        uploadExecutor.execute(() -> {
            HttpURLConnection conn = null;
            try {
                Log.d("UPLOAD", "Starting background multipart upload...");
                String boundary = "----Boundary" + System.currentTimeMillis();
                URL url = new URL(BASE_URL + "/analyze");

                conn = (HttpURLConnection) url.openConnection();
                conn.setRequestMethod("POST");
                conn.setDoOutput(true);
                conn.setDoInput(true);
                conn.setUseCaches(false);
                conn.setConnectTimeout(30000);
                conn.setReadTimeout(30000);
                conn.setRequestProperty("Connection", "Keep-Alive");
                conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);

                DataOutputStream dos = new DataOutputStream(conn.getOutputStream());

                // Directly upload the pre-compressed JPEG data stream
                // Directly upload the pre-compressed JPEG data stream
                for (int i = 0; i < frames.size(); i++) {

                    FrameData frame = frames.get(i);

                    Log.d("UPLOAD_DEBUG",
                            "Uploading Frame[" + i + "]" +
                                    " | bytes=" + frame.jpegData.length +
                                    " | hash=" + java.util.Arrays.hashCode(frame.jpegData) +
                                    " | quality=" + frame.qualityScore);

                    Log.d("UPLOAD", "Sending in-memory frame: frame_" + i + ".jpg");

                    dos.writeBytes("--" + boundary + "\r\n");
                    dos.writeBytes("Content-Disposition: form-data; name=\"image\"; filename=\"frame_" + i + ".jpg\"\r\n");
                    dos.writeBytes("Content-Type: image/jpeg\r\n\r\n");

                    dos.write(frame.jpegData);

                    dos.writeBytes("\r\n");
                }

                // Metadata
                dos.writeBytes("--" + boundary + "\r\n");
                dos.writeBytes("Content-Disposition: form-data; name=\"lat\"\r\n\r\n");
                dos.writeBytes(location.getLatitude() + "\r\n");

                dos.writeBytes("--" + boundary + "\r\n");
                dos.writeBytes("Content-Disposition: form-data; name=\"lon\"\r\n\r\n");
                dos.writeBytes(location.getLongitude() + "\r\n");

                dos.writeBytes("--" + boundary + "\r\n");
                dos.writeBytes("Content-Disposition: form-data; name=\"vibration\"\r\n\r\n");
                dos.writeBytes(lastVibrationValue + "\r\n");

                dos.writeBytes("--" + boundary + "--\r\n");
                dos.flush();
                dos.close();

                Log.d("UPLOAD", "Waiting for server response...");
                int response = conn.getResponseCode();
                Log.d("UPLOAD", "Response code: " + response);

                if (response >= 200 && response < 300) {

                    // Mark uploaded frames as processed
                    lastProcessedFrameId = frames.stream()
                            .mapToLong(f -> f.frameId)
                            .max()
                            .orElse(lastProcessedFrameId);

                    Log.d("FRAME_FILTER",
                            "Updated lastProcessedFrameId = " + lastProcessedFrameId);
                }

                BufferedReader reader;
                if (response >= 200 && response < 300) {
                    reader = new BufferedReader(new InputStreamReader(conn.getInputStream()));
                } else {
                    reader = new BufferedReader(new InputStreamReader(conn.getErrorStream()));
                }

                String line;
                while ((line = reader.readLine()) != null) {
                    Log.d("UPLOAD_RESPONSE", line);
                }
                reader.close();
                Log.d("UPLOAD", "Upload completed successfully");

            } catch (Exception e) {
                Log.e("UPLOAD", "Upload failed", e);
            } finally {
                if (conn != null) conn.disconnect();
                // Ensure finishDetection() is unconditionally called
                finishDetection();
            }
        });
    }

    // =========================================================
    // LIFECYCLE
    // =========================================================

    @Override
    protected void onResume() {
        super.onResume();
        if (sensorManager != null && accelerometer != null) {
            sensorManager.registerListener(this, accelerometer, SensorManager.SENSOR_DELAY_NORMAL);
        }
    }

    @Override
    protected void onPause() {
        super.onPause();
        if (sensorManager != null) {
            sensorManager.unregisterListener(this);
        }
    }

    @Override
    protected void onDestroy() {
        if (analysisExecutor != null && !analysisExecutor.isShutdown()) {
            analysisExecutor.shutdownNow();
        }
        if (uploadExecutor != null && !uploadExecutor.isShutdown()) {
            uploadExecutor.shutdownNow();
        }
        synchronized (frameBuffer) {
            frameBuffer.clear();
        }
        super.onDestroy();
    }
}
