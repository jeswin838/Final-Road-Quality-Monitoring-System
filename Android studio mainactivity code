    private void processRawFrame(ImageProxy image) {
        ByteBuffer yBuffer = image.getPlanes()[0].getBuffer();
        yBuffer.rewind(); // Crucial: ensure buffer starts at zero before reading
        byte[] yData = new byte[yBuffer.remaining()];
        yBuffer.get(yData);

        int width = image.getWidth();
        int height = image.getHeight();

        QualityResult result = calculateQualityAndMotion(yData, width, height, image.getPlanes()[0].getRowStride());

        // Reject garbage frames immediately
        if (result.score < 0) {
            return;
        }

        // 1. AI VISION TRIGGER (Lightweight Optical Flow Check - Secondary)
        if (result.aiTriggerAnomaly) {
            long now = System.currentTimeMillis();
            // Check if a primary trigger has fired recently
            if (now - lastPrimaryTriggerTime.get() > AI_VISION_COOLDOWN_MS) {
                Log.d(TAG, "AI_VISION_TRIGGER: Sudden visual motion/anomaly detected! Requesting detection.");
                requestDetection();
            } else {
                Log.d(TAG, "AI_VISION_TRIGGER: Anomaly detected but ignored due to recent Primary Trigger.");
            }
        }

        // 2. Buffer the good frame (Proven Production ImageProxy to JPEG Conversion)
        // 2. Buffer the good frame (Proven Production ImageProxy to JPEG Conversion)
        byte[] jpegData = imageProxyToJpeg(image);

        long captureTime = System.currentTimeMillis();
        int frameHash = java.util.Arrays.hashCode(jpegData);

        Log.d("FRAME_CAPTURE",
                "NEW FRAME | " +
                        "time=" + captureTime +
                        " bytes=" + jpegData.length +
                        " hash=" + frameHash +
                        " quality=" + result.score);

        synchronized (frameBuffer) {

            Log.d("FRAME_BUFFER",
                    "Before Add | size=" + frameBuffer.size());

            if (frameBuffer.size() >= 30) {

                FrameData removed = frameBuffer.pollFirst();

                Log.d("FRAME_BUFFER",
                        "Removed oldest hash=" +
                                java.util.Arrays.hashCode(removed.jpegData));
            }

            FrameData newFrame = new FrameData(
                    jpegData,
                    width,
                    height,
                    result.score,
                    frameCounter.incrementAndGet()
            );

            frameBuffer.addLast(newFrame);

            Log.d("FRAME_BUFFER",
                    "Added frameId=" + newFrame.frameId +
                            " hash=" + java.util.Arrays.hashCode(newFrame.jpegData) +
                            " quality=" + newFrame.qualityScore +
                            " size=" + frameBuffer.size());

            Log.d("FRAME_BUFFER",
                    "After Add | size=" + frameBuffer.size());
        }
    }

    private QualityResult calculateQualityAndMotion(byte[] yData, int width, int height, int rowStride) {
        long sumBrightness = 0;
        long laplacianSum = 0;
        long motionDiffSum = 0;
        int pixelCount = 0;
        int step = 4;

        // RESTRICT QUALITY SCORING TO ROAD REGION (Lower 65%)
        int startY = (int) (height * 0.35);

        for (int y = startY; y < height - 1; y += step) {
            for (int x = 1; x < width - 1; x += step) {
                int idx = y * rowStride + x;
                int p = yData[idx] & 0xFF;
                sumBrightness += p;
                pixelCount++;

                int top = yData[idx - rowStride] & 0xFF;
                int bottom = yData[idx + rowStride] & 0xFF;
                int left = yData[idx - 1] & 0xFF;
                int right = yData[idx + 1] & 0xFF;

                // Sharpness/Blur checking
                laplacianSum += Math.abs((p * 4) - top - bottom - left - right);

                // Motion/Optical flow checking against previous frame
                if (previousYData != null && previousYData.length == yData.length) {
                    int prevP = previousYData[idx] & 0xFF;
                    motionDiffSum += Math.abs(p - prevP);
                }
            }
        }

        // Save current frame for the next motion check
        if (previousYData == null || previousYData.length != yData.length) {
            previousYData = new byte[yData.length];
        }
        System.arraycopy(yData, 0, previousYData, 0, yData.length);

        float avgBrightness = (float) sumBrightness / pixelCount;
        float blurVariance = (float) laplacianSum / pixelCount;
        float motionScore = (previousYData != null) ? ((float) motionDiffSum / pixelCount) : 0;

        // Hard rejections (Too dark, washed out, or too blurry)
        if (avgBrightness < 40 || avgBrightness > 230) return new QualityResult(-1.0f, false);
        if (blurVariance < 10.0f) return new QualityResult(-1.0f, false);

        // AI Vision Trigger: Spikes in motion score indicate sudden jolts/bumps in the frame
        boolean isAnomaly = (motionScore > 45.0f);

        // Weighted Frame Stability Ranking
        float brightnessPenalty = Math.abs(avgBrightness - 128) / 128f;
        float motionPenalty = Math.min(motionScore / 100f, 1.0f); // Penalize frames captured exactly during a blur streak

        // FINAL SCORE: 60% Sharpness, 20% Perfect Exposure, 20% Motion Stability
        float finalScore = (blurVariance * 0.60f) + ((1.0f - brightnessPenalty) * 20.0f) + ((1.0f - motionPenalty) * 20.0f);

        return new QualityResult(finalScore, isAnomaly);
    }

    /**
     * Proven Production Implementation: ImageProxy (YUV_420_888) directly to JPEG.
     * Extracts planes sequentially using correct row/pixel strides, avoiding
     * device-specific array padding corruption (fixes Xiaomi, Samsung, Motorola striping).
     * Reuses buffers strictly to maintain fast real-time CPU performance.
     */
    private byte[] imageProxyToJpeg(ImageProxy image) {
        ImageProxy.PlaneProxy[] planes = image.getPlanes();
        ByteBuffer yBuffer = planes[0].getBuffer();
        ByteBuffer uBuffer = planes[1].getBuffer();
        ByteBuffer vBuffer = planes[2].getBuffer();

        // Rewind to ensure data extraction starts cleanly at position 0
        yBuffer.rewind();
        uBuffer.rewind();
        vBuffer.rewind();

        int width = image.getWidth();
        int height = image.getHeight();

        int yRowStride = planes[0].getRowStride();
        int yPixelStride = planes[0].getPixelStride();
        int uRowStride = planes[1].getRowStride();
        int uPixelStride = planes[1].getPixelStride();
        int vRowStride = planes[2].getRowStride();
        int vPixelStride = planes[2].getPixelStride();

        int ySize = width * height;
        int uvSize = ySize / 2;
        int nv21Size = ySize + uvSize;

        // Initialize or resize reusable buffers only if strictly necessary
        if (nv21Buffer == null || nv21Buffer.length != nv21Size) {
            nv21Buffer = new byte[nv21Size];
        }
        if (yRowBuffer == null || yRowBuffer.length < yRowStride) yRowBuffer = new byte[yRowStride];
        if (uRowBuffer == null || uRowBuffer.length < uRowStride) uRowBuffer = new byte[uRowStride];
        if (vRowBuffer == null || vRowBuffer.length < vRowStride) vRowBuffer = new byte[vRowStride];

        int pos = 0;

        // 1. Properly extract Y plane (Luma) row-by-row
        if (yRowStride == width && yPixelStride == 1) {
            // Fast-path: Buffer is contiguous and not padded
            yBuffer.get(nv21Buffer, 0, ySize);
            pos += ySize;
        } else {
            // Slow-path: Safely strip padding away from the end of each row
            for (int y = 0; y < height; y++) {
                int bytesToRead = Math.min(yBuffer.remaining(), yRowStride);
                yBuffer.get(yRowBuffer, 0, bytesToRead);
                for (int x = 0; x < width; x++) {
                    nv21Buffer[pos++] = yRowBuffer[x * yPixelStride];
                }
            }
        }

        // 2. Properly extract U and V planes (Chroma). NV21 expects V, then U.
        int uvHeight = height / 2;
        int uvWidth = width / 2;

        for (int y = 0; y < uvHeight; y++) {
            int vBytesToRead = Math.min(vBuffer.remaining(), vRowStride);
            vBuffer.get(vRowBuffer, 0, vBytesToRead);

            int uBytesToRead = Math.min(uBuffer.remaining(), uRowStride);
            uBuffer.get(uRowBuffer, 0, uBytesToRead);

            for (int x = 0; x < uvWidth; x++) {
                nv21Buffer[pos++] = vRowBuffer[x * vPixelStride];
                nv21Buffer[pos++] = uRowBuffer[x * uPixelStride];
            }
        }

        // 3. Perform correct JPEG compression
        // 3. Convert NV21 -> JPEG
        YuvImage yuvImage = new YuvImage(nv21Buffer, ImageFormat.NV21, width, height, null);

        jpegOutputStream.reset();
        yuvImage.compressToJpeg(new Rect(0, 0, width, height), 90, jpegOutputStream);

// 4. Decode JPEG into Bitmap
        byte[] jpegBytes = jpegOutputStream.toByteArray();
        Bitmap bitmap = BitmapFactory.decodeByteArray(jpegBytes, 0, jpegBytes.length);

// 5. Rotate according to CameraX metadata
        int rotation = image.getImageInfo().getRotationDegrees();

        if (rotation != 0) {
            Matrix matrix = new Matrix();
            matrix.postRotate(rotation);

            bitmap = Bitmap.createBitmap(
                    bitmap,
                    0,
                    0,
                    bitmap.getWidth(),
                    bitmap.getHeight(),
                    matrix,
                    true
            );
        }

// 6. Compress rotated Bitmap back to JPEG
        jpegOutputStream.reset();
        bitmap.compress(Bitmap.CompressFormat.JPEG, 90, jpegOutputStream);

        bitmap.recycle();

        return jpegOutputStream.toByteArray();
    }

