    @Override
    public void onSensorChanged(SensorEvent event) {
        if (event.sensor.getType() == Sensor.TYPE_ACCELEROMETER) {
            float x = event.values[0];
            float y = event.values[1];
            float z = event.values[2];

            double totalAcceleration = Math.sqrt(x * x + y * y + z * z);
            double linearAcceleration = Math.abs(totalAcceleration - SensorManager.GRAVITY_EARTH);
            lastVibrationValue = (float) linearAcceleration;

            if (linearAcceleration > VIBRATION_THRESHOLD) {
                Log.d("VIBRATION_SENSOR", "Value: " + lastVibrationValue);
                lastPrimaryTriggerTime.set(System.currentTimeMillis());
                requestDetection();
            }
        }
    }

    @Override
    public void onAccuracyChanged(Sensor sensor, int accuracy) {}

    void startCheckingTrigger() {
        new Thread(() -> {
            while (!Thread.currentThread().isInterrupted()) {
                try {
                    // Do NOT skip based on isProcessing. Just request.
                    URL url = new URL(BASE_URL + "/check");
                    HttpURLConnection conn = (HttpURLConnection) url.openConnection();
                    conn.setRequestMethod("GET");
                    conn.setConnectTimeout(2000);
                    conn.setReadTimeout(2000);

                    if (conn.getResponseCode() == 200) {
                        BufferedReader reader = new BufferedReader(new InputStreamReader(conn.getInputStream()));
                        StringBuilder builder = new StringBuilder();
                        String line;
                        while ((line = reader.readLine()) != null) {
                            builder.append(line);
                        }

                        JSONObject json = new JSONObject(builder.toString());
                        if (json.getBoolean("capture")) {
                            Log.d(TAG, "ESP32 POTHOLE TRIGGER");
                            lastPrimaryTriggerTime.set(System.currentTimeMillis());
                            requestDetection();
                        }
                    }
                    conn.disconnect();
                    Thread.sleep(1000);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                } catch (Exception e) {
                    try { Thread.sleep(2000); } catch (Exception ignored) {}
                }
            }
        }).start();
    }

    void startPeriodicAIScan() {
        new Thread(() -> {
            while (!Thread.currentThread().isInterrupted()) {
                try {
                    Thread.sleep(3000); // Periodic live detection
                    Log.d(TAG, "Running periodic scan");
                    lastPrimaryTriggerTime.set(System.currentTimeMillis());
                    requestDetection();
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                } catch (Exception e) {
                    Log.e(TAG, "Periodic scan failed", e);
                }
            }
        }).start();
    }

